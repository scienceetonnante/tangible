{
  "name": "tangible",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build",
    "lesson": "node packages/cli/dist/index.js",
    "typecheck": "tsc --build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint .",
    "boundaries": "node scripts/check-boundaries.mjs",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm boundaries && pnpm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/three": "^0.185.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@tangible/ingredients": "workspace:*",
    "three": "^0.185.1"
  }
}
